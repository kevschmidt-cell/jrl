<?xml version="1.0" encoding="utf-8"?>
<robot name="simple_robot_01">
    <link name="world"/>
    <!--joint between {parent} and link_0-->
    <joint name="world_joint" type="fixed">
        <origin xyz="0 -1.0 0" rpy="0.0 0.0 0.0"/>
        <parent link="world"/>
        <child link="base_link"/>
    </joint>
    <!-- Link 0: Base -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="urdfs/simple_robot_01/meshes/base_link2.stl"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="urdfs/simple_robot_01/meshes/base_link2.stl"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </collision>
    </link>

    <!-- Joint 1 -->
    <joint name="joint1" type="revolute">
        <parent link="base_link"/>
        <child link="link_1"/>
        <origin xyz="0 0 -0.05" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>
    <!-- Joint 2 --> 
    <joint name="joint2" type="revolute">
        <parent link="link_1"/>
        <child link="link_2"/>
        <origin xyz="0 0 -1" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>
    <!-- Joint 3 --> 
    <joint name="joint3" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="0 0 -1.0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>
    <!-- Joint 4 --> 
    <joint name="joint4" type="fixed">
        <parent link="link_3"/>
        <child link="end_effector"/>
        <origin xyz="0 0 -1.1" rpy="0 0 0"/>
    </joint>

    <!-- Link 1-->
    <link name="link_1">
        <visual>
            <origin xyz="0 0 -0.5" rpy="0 0 0"/>
            <geometry>
                <mesh filename="urdfs/simple_robot_01/meshes/link_x2.stl"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 -0.5" rpy="0 0 0"/>
            <geometry>
                <mesh filename="urdfs/simple_robot_01/meshes/link_x2.stl"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.00" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.00"/>
            <origin xyz="0 0 -0.5" rpy="0 0 0"/>
        </inertial>
    </link>

     <!-- Link 2: End Effector -->
    <link name="link_2">
        <visual>
            <origin xyz="0 0 -0.5" rpy="0 0 0"/>
            <geometry>
                <mesh filename="urdfs/simple_robot_01/meshes/link_x2.stl"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 -0.5" rpy="0 0 0"/>
            <geometry>
                <mesh filename="urdfs/simple_robot_01/meshes/link_x2.stl"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </collision>
       <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.00" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.00"/>
            <origin xyz="0 0 -0.5" rpy="0 0 0"/>
        </inertial>
    </link>

    <!-- Link 3: End Effector -->
    <link name="link_3">
        <visual>
            <origin xyz="0 0 -0.5" rpy="0 0 0"/>
            <geometry>
                <mesh filename="urdfs/simple_robot_01/meshes/link_x2.stl"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 -0.5" rpy="0 0 0"/>
            <geometry>
                <mesh filename="urdfs/simple_robot_01/meshes/link_x2.stl"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </collision>
       <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.00" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.00"/>
            <origin xyz="0 0 -0.5" rpy="0 0 0"/>
        </inertial>
    </link>

    <!-- End Effector -->
    <link name="end_effector">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="urdfs/simple_robot_01/meshes/end_effector2.stl"/>
            </geometry>
            <material name="green">
                <color rgba="0 1 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="urdfs/simple_robot_01/meshes/end_effector2.stl"/>
            </geometry>
            <material name="green">
                <color rgba="0 1 0 1"/>
            </material>
        </collision>
    </link>
</robot>